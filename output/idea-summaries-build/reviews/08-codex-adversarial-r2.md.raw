      40 docs/idea-summaries/images/08/predicted-routes-by-optimizer.svg
     1	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1300 500" width="1300" height="500" font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" role="img" aria-labelledby="t d">
     2	<title id="t">Where each optimizer puts the context</title>
     3	<desc id="d">Hypothetical pre-registered predictions at the final checkpoint: under accuracy reward both optimizer types reach the predicted shrinkage band, but only prompt and playbook evolution put most of the framing effect through the analysis path.</desc>
     4	<defs></defs>
     5	<rect x="0.75" y="0.75" width="1298.5" height="498.5" rx="16" fill="#ffffff" stroke="#e5e7eb" stroke-width="1.5"/>
     6	<text x="40.0" y="40.0" font-size="17.7" font-weight="700" fill="#6b7280" text-anchor="start" font-style="italic">Hypothetical, pre-registered predictions at the final checkpoint</text>
     7	<text x="40.0" y="70.0" font-size="17.7" font-weight="700" fill="#1f2328" text-anchor="start">Under reward (a) both optimizer types reach the band; only GEPA and ACE put most of it through the path</text>
     8	<rect x="670.3" y="150.0" width="415.0" height="270.0" rx="0" fill="#eceef1" stroke="#eceef1" stroke-width="0"/>
     9	<line x1="877.8" y1="150.0" x2="877.8" y2="420.0" stroke="#6b7280" stroke-width="1.4" stroke-linecap="round"/>
