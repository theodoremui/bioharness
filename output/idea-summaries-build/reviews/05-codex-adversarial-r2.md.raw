    19	<text x="224.0" y="174.0" font-size="15.3" font-weight="400" fill="#6b7280" text-anchor="end">cell</text>
    20	<text x="224.0" y="221.0" font-size="17.7" font-weight="700" fill="#1f2328" text-anchor="end">modularity</text>
    21	<text x="224.0" y="261.0" font-size="17.7" font-weight="700" fill="#1f2328" text-anchor="end">observability</text>
