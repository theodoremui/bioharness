     9	<text x="54.0" y="168.7" font-size="16.5" font-weight="400" fill="#4b5563" text-anchor="start">400 lines, constants inlined, nothing</text>
    10	<text x="54.0" y="191.5" font-size="16.5" font-weight="400" fill="#4b5563" text-anchor="start">logged</text>
