    13	<text x="54.0" y="354.7" font-size="16.5" font-weight="400" fill="#4b5563" text-anchor="start">Logged stages, named config with</text>
    14	<text x="54.0" y="377.5" font-size="16.5" font-weight="400" fill="#4b5563" text-anchor="start">units, warning-only checks</text>
    15	<rect x="448.0" y="206.0" width="196.0" height="112.0" rx="12" fill="#ffffff" stroke="#d6d9de" stroke-width="1.5"/>
